# Copy this file to ".env" (same folder as docker-compose.yml) and adjust values as needed.
# All variables below have safe local-dev defaults baked into docker-compose.yml,
# so "docker compose up" works even without creating a .env file.
# Never commit your real ".env" file.

# PostgreSQL
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=eloja

# RabbitMQ
RABBITMQ_USER=dev
RABBITMQ_PASSWORD=dev

# Redis
REDIS_PASSWORD=dev

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin
MONGO_APP_USER=dev
MONGO_APP_PASSWORD=dev

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# JWT signing key used by eloja.API (Base64 string, any random value works for local dev).
# Generate your own with: openssl rand -base64 32
JWT_KEY=CHANGE_ME_INSECURE_DEV_ONLY_KEY_1234567890==
